    "nfc_pairing.error.unsupported" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unsupported tag format. Please try standard NTAG or transit cards."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Định dạng thẻ không hỗ trợ. Vui lòng thử thẻ NTAG hoặc thẻ xe thông dụng."
          }
        }
      }
    },
    "nfc_pairing.step1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Place the tag away from your desk or bed (e.g. Fridge)."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Đặt thẻ ở xa bàn làm việc hoặc giường ngủ (ví dụ: Tủ lạnh)."
          }
        }
      }
    },
    "nfc_pairing.step2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. Tap phone to register this tag as your unlock key."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. Chạm điện thoại để đăng ký thẻ làm chìa khóa mở."
          }
        }
      }
    },
    "nfc_pairing.step3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. Whenever you need to unlock, you must walk to the tag."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. Mỗi khi muốn mở khóa, bạn buộc phải đứng dậy đi tới thẻ."
          }
        }
      }
    },
