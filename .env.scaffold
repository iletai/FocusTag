# Environment variables for ios-new-app scaffold
# Usage:
#   source .env.scaffold
#   APPLE_TEAM_ID="$APPLE_TEAM_ID" ~/.agents/skills/ios-new-app/scripts/new_app.sh "$APP_NAME" "$BUNDLE_ID" ~/Developer/"$APP_NAME" --with "$FEATURES"

export APP_NAME="FocusTag"
export BUNDLE_ID="com.iletai.focustag"
export APP_SLUG="focustag"
export APPLE_TEAM_ID="AP58YLHQ2S"
export FEATURES="storekit,nav,update"
export SITE_BASE_URL="https://apps-site-six.vercel.app"
export COPYRIGHT_HOLDER="iletai"
